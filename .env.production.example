# ========================================
# PDFLab Production Environment Variables
# ========================================
# INSTRUCTIONS:
# 1. Copy this file to your Hostinger VPS at /opt/pdflab/.env
# 2. Replace ALL placeholder values marked with <CHANGE_THIS>
# 3. Never commit the actual .env file to git (keep secrets secure)
# 4. Use strong, unique values for all secrets
# ========================================

# ========================================
# SERVER CONFIGURATION
# ========================================
NODE_ENV=production
PORT=3006
# Your production API URL (e.g., https://api.pdflab.com or https://yourdomain.com/api)
API_URL=<CHANGE_THIS_TO_YOUR_DOMAIN>

# ========================================
# DATABASE CONFIGURATION (MySQL)
# ========================================
# For Docker: use service name 'mysql' as host
# For external DB: use actual hostname/IP
DB_HOST=mysql
DB_PORT=3306
# SECURITY: Change default credentials!
DB_USER=<CHANGE_THIS_DB_USER>
DB_PASSWORD=<CHANGE_THIS_STRONG_PASSWORD_MIN_16_CHARS>
DB_NAME=pdflab

# ========================================
# REDIS CONFIGURATION
# ========================================
# For Docker: use service name 'redis' as host
# For external Redis: use actual hostname/IP
REDIS_HOST=redis
REDIS_PORT=6379
# SECURITY: Add strong password in production!
REDIS_PASSWORD=<CHANGE_THIS_REDIS_PASSWORD_MIN_16_CHARS>

# ========================================
# CLOUDCONVERT API (PDF Processing)
# ========================================
# Get your API key from: https://cloudconvert.com/dashboard/api/v2/keys
# IMPORTANT: Use production API key (not sandbox)
CLOUDCONVERT_API_KEY=<CHANGE_THIS_YOUR_CLOUDCONVERT_API_KEY>
CLOUDCONVERT_SANDBOX=false

# ========================================
# JWT AUTHENTICATION
# ========================================
# CRITICAL SECURITY: Generate strong random secrets!
# Use: openssl rand -base64 64
JWT_SECRET=<CHANGE_THIS_GENERATE_STRONG_RANDOM_SECRET_MIN_64_CHARS>
JWT_EXPIRATION=7d
JWT_REFRESH_EXPIRATION=30d

# ========================================
# STORAGE CONFIGURATION
# ========================================
# For Docker: use relative path (Docker volume handles persistence)
STORAGE_PATH=./storage

# ========================================
# FILE UPLOAD LIMITS (bytes)
# ========================================
# Free: 10MB, Starter: 25MB, Pro: 100MB, Enterprise: 500MB
MAX_FILE_SIZE_FREE=10485760
MAX_FILE_SIZE_STARTER=26214400
MAX_FILE_SIZE_PRO=104857600
MAX_FILE_SIZE_ENTERPRISE=524288000

# ========================================
# CONVERSION LIMITS (per month)
# ========================================
# Free: 3, Starter: 100, Pro/Enterprise: unlimited (-1)
CONVERSIONS_LIMIT_FREE=3
CONVERSIONS_LIMIT_STARTER=100
CONVERSIONS_LIMIT_PRO=-1
CONVERSIONS_LIMIT_ENTERPRISE=-1

# ========================================
# CORS CONFIGURATION
# ========================================
# Your production frontend URL(s) - comma separated
# Example: https://pdflab.com,https://www.pdflab.com
CORS_ORIGIN=<CHANGE_THIS_YOUR_FRONTEND_DOMAIN>

# ========================================
# RATE LIMITING
# ========================================
# 15 minutes (900000ms), 100 requests per IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ========================================
# PAYFAST PAYMENT GATEWAY (USD)
# ========================================
# Get credentials from: https://www.payfast.io/
# IMPORTANT: These are your PRODUCTION credentials
PAYFAST_MERCHANT_ID=<CHANGE_THIS_YOUR_PRODUCTION_MERCHANT_ID>
PAYFAST_MERCHANT_KEY=<CHANGE_THIS_YOUR_PRODUCTION_MERCHANT_KEY>
# Passphrase: Optional but HIGHLY RECOMMENDED for security
PAYFAST_PASSPHRASE=<CHANGE_THIS_STRONG_PASSPHRASE_MIN_16_CHARS>
PAYFAST_MODE=production

# ========================================
# EMAIL CONFIGURATION (Optional)
# ========================================
# For sending notifications, password resets, etc.
# SMTP_HOST=<YOUR_SMTP_HOST>
# SMTP_PORT=587
# SMTP_USER=<YOUR_EMAIL>
# SMTP_PASSWORD=<YOUR_EMAIL_PASSWORD>
# SMTP_FROM=noreply@yourdomain.com

# ========================================
# FRONTEND ENVIRONMENT VARIABLES
# ========================================
# Note: Frontend needs separate .env file with:
# NEXT_PUBLIC_API_URL=<YOUR_API_URL>

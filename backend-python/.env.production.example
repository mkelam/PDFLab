# PDFLab Backend - Production Environment Variables Template
# Copy this file to .env and fill in your production values

# Server Configuration
NODE_ENV=production
PORT=3007
API_URL=https://api.pdflab.pro

# Database (Production MySQL)
DB_HOST=your-production-db-host.com
DB_PORT=3306
DB_USER=pdflab_prod
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=pdflab_prod

# Redis (Production - Job Queue)
REDIS_HOST=your-production-redis-host.com
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# CloudConvert API (PDF Processing)
CLOUDCONVERT_API_KEY=your_cloudconvert_api_key
CLOUDCONVERT_SANDBOX=false

# JWT Authentication
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_64
JWT_EXPIRATION=7d

# PayFast Payment Gateway (USD)
PAYFAST_MERCHANT_ID=25263515
PAYFAST_MERCHANT_KEY=***REMOVED***
PAYFAST_PASSPHRASE=CHANGE_ME_OPTIONAL_BUT_RECOMMENDED
PAYFAST_MODE=production

# Email Configuration (Hostinger SMTP)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=support@pdflab.pro
SMTP_PASSWORD=your_email_password
SMTP_FROM_EMAIL=support@pdflab.pro
SMTP_FROM_NAME=PDFLab
SMTP_USE_TLS=True

# Frontend URL (for email verification/reset links)
FRONTEND_URL=https://www.pdflab.pro

# CORS Configuration
CORS_ORIGIN=https://www.pdflab.pro

# Optional: Sentry Error Tracking
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

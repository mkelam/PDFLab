# Server Configuration
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=pdflab
DB_PASSWORD=your-secure-password
DB_NAME=pdflab

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CloudConvert API
CLOUDCONVERT_API_KEY=your-cloudconvert-api-key
CLOUDCONVERT_WEBHOOK_SECRET=your-webhook-secret
CLOUDCONVERT_SANDBOX=true

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-min-32-characters-long
JWT_EXPIRATION=7d
JWT_REFRESH_EXPIRATION=30d

# Email/SMTP Configuration (for password reset emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM_NAME=PDFLab
SMTP_FROM_EMAIL=noreply@pdflab.com
FRONTEND_URL=http://localhost:3000

# Storage
STORAGE_PATH=./storage

# File Upload Limits (in bytes)
MAX_FILE_SIZE_FREE=10485760
MAX_FILE_SIZE_STARTER=26214400
MAX_FILE_SIZE_PRO=104857600

# Conversion Limits
CONVERSIONS_LIMIT_FREE=3
CONVERSIONS_LIMIT_STARTER=100
CONVERSIONS_LIMIT_PRO=-1

# PayPal Configuration
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox
PAYPAL_SUCCESS_URL=http://localhost:3000/payment/success
PAYPAL_CANCEL_URL=http://localhost:3000/payment/cancel
PAYPAL_WEBHOOK_ID=your-paypal-webhook-id
# PayPal Plan IDs (create these in PayPal dashboard for recurring subscriptions)
PAYPAL_PLAN_STARTER=
PAYPAL_PLAN_PRO=
PAYPAL_PLAN_ENTERPRISE=

# Stripe (Future)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

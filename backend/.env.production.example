# Production Environment Configuration (EXAMPLE)
#
# Copy to `backend/.env.production` (do not commit) or provide via container env vars.
# Never commit real secrets (DB password, JWT secret, CloudConvert key, SMTP password, PayFast passphrase).
#
# Required baseline
NODE_ENV=production
PORT=3006
API_URL=https://pdflab.pro
FRONTEND_URL=https://pdflab.pro

# Database (MySQL)
DB_HOST=mysql
DB_PORT=3306
DB_USER=pdflab
DB_PASSWORD=change_me
DB_NAME=pdflab_production

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# CloudConvert
CLOUDCONVERT_API_KEY=change_me
CLOUDCONVERT_SANDBOX=false

# JWT Authentication
JWT_SECRET=change_me
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=30d

# PayFast (Production - Legacy)
PAYFAST_MERCHANT_ID=change_me
PAYFAST_MERCHANT_KEY=change_me
PAYFAST_PASSPHRASE=change_me
PAYFAST_MODE=production
PAYFAST_ITN_URL=https://pdflab.pro/api/payfast/webhook
PAYFAST_RETURN_URL=https://pdflab.pro/payment/success
PAYFAST_CANCEL_URL=https://pdflab.pro/payment/cancel

# PayPal (Production)
PAYPAL_CLIENT_ID=change_me
PAYPAL_CLIENT_SECRET=change_me
PAYPAL_MODE=production
PAYPAL_SUCCESS_URL=https://pdflab.pro/payment/success
PAYPAL_CANCEL_URL=https://pdflab.pro/payment/cancel
PAYPAL_WEBHOOK_ID=7JN28627GU761074G
# PayPal Plan IDs (create in PayPal dashboard)
PAYPAL_PLAN_STARTER=change_me
PAYPAL_PLAN_PRO=change_me
PAYPAL_PLAN_ENTERPRISE=change_me

# CORS
CORS_ORIGIN=https://pdflab.pro,https://www.pdflab.pro,https://api.pdflab.pro,https://partners.pdflab.pro

# Storage & upload limits
STORAGE_PATH=/app/storage
MAX_FILE_SIZE=524288000
MAX_FILE_SIZE_FREE=10485760
MAX_FILE_SIZE_STARTER=26214400
MAX_FILE_SIZE_PRO=104857600
MAX_FILE_SIZE_ENTERPRISE=524288000
CONVERSIONS_LIMIT_FREE=3
CONVERSIONS_LIMIT_STARTER=100
CONVERSIONS_LIMIT_PRO=-1
CONVERSIONS_LIMIT_ENTERPRISE=-1

# SMTP
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=support@pdflab.pro
SMTP_PASS=change_me
SMTP_FROM_NAME=PDFLab
SMTP_FROM_EMAIL=support@pdflab.pro

# Optional monitoring
# SENTRY_DSN=
# SENTRY_DEV=false

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || 'PDFLab API' %></title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            line-height: 1.6;
            background: linear-gradient(
                oklch(0.05 0 0 / 0.5),
                oklch(0.05 0 0 / 0.5)
            ), url("/images/circuit-board-bg.png") center / cover no-repeat fixed,
            oklch(0.05 0 0);
            color: oklch(0.95 0 0);
            min-height: 100vh;
            padding: 20px;
            position: relative;
        }

        /* Grain texture overlay */
        body::before {
            content: "";
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            opacity: 0.02;
            z-index: 1;
            pointer-events: none;
            background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='turbulence' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)' opacity='0.5'/%3E%3C/svg%3E");
        }

        .container {
            max-width: 1400px;
            margin: 0 auto;
            position: relative;
            z-index: 2;
        }

        header {
            background: oklch(0 0 0 / 0.5);
            border: 1px solid oklch(1 0 0 / 0.15);
            border-radius: 0.75rem;
            padding: 40px;
            margin-bottom: 24px;
        }

        header h1 {
            font-size: 2.5em;
            margin-bottom: 12px;
            font-weight: 700;
            background: linear-gradient(to right, oklch(0.6 0.1 180), oklch(0.7 0.12 180), oklch(0.8 0.1 180));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        header p {
            font-size: 1.1em;
            color: oklch(0.65 0 0);
        }

        .content {
            position: relative;
            z-index: 2;
        }

        .badge {
            display: inline-block;
            padding: 6px 14px;
            border-radius: 6px;
            font-size: 0.85em;
            font-weight: 600;
            margin-left: 10px;
            border: 1px solid;
        }

        .badge.success {
            background: oklch(0.5 0.15 150 / 0.2);
            color: oklch(0.7 0.15 150);
            border-color: oklch(0.5 0.15 150 / 0.3);
        }

        .badge.error {
            background: oklch(0.5 0.2 25 / 0.2);
            color: oklch(0.7 0.2 25);
            border-color: oklch(0.5 0.2 25 / 0.3);
        }

        .badge.warning {
            background: oklch(0.65 0.15 65 / 0.2);
            color: oklch(0.8 0.15 65);
            border-color: oklch(0.65 0.15 65 / 0.3);
        }

        .badge.info {
            background: oklch(0.6 0.1 180 / 0.2);
            color: oklch(0.7 0.1 180);
            border-color: oklch(0.6 0.1 180 / 0.3);
        }

        .card {
            background: oklch(0 0 0 / 0.5);
            border: 1px solid oklch(1 0 0 / 0.15);
            border-radius: 0.75rem;
            padding: 32px;
            margin-bottom: 24px;
        }

        .card h2 {
            color: oklch(0.95 0 0);
            margin-bottom: 20px;
            font-size: 1.5em;
            font-weight: 600;
        }

        .card h3 {
            color: oklch(0.8 0 0);
            margin-bottom: 16px;
            margin-top: 24px;
            font-size: 1.2em;
            font-weight: 600;
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin: 24px 0;
        }

        .info-item {
            background: oklch(0.08 0 0 / 0.5);
            border: 1px solid oklch(1 0 0 / 0.1);
            padding: 24px;
            border-radius: 0.75rem;
            border-left: 3px solid oklch(0.6 0.1 180);
        }

        .info-item .label {
            font-size: 0.85em;
            color: oklch(0.65 0 0);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 8px;
        }

        .info-item .value {
            font-size: 1.8em;
            font-weight: 700;
            color: oklch(0.95 0 0);
        }

        .endpoint-list {
            list-style: none;
        }

        .endpoint-list li {
            background: oklch(0.08 0 0 / 0.5);
            border: 1px solid oklch(1 0 0 / 0.1);
            padding: 18px 24px;
            margin-bottom: 12px;
            border-radius: 0.75rem;
            border-left: 3px solid oklch(0.6 0.1 180);
            display: flex;
            align-items: center;
            transition: all 0.2s ease;
        }

        .endpoint-list li:hover {
            background: oklch(0.1 0 0 / 0.6);
            border-left-color: oklch(0.7 0.12 180);
            transform: translateX(4px);
        }

        .method {
            display: inline-block;
            padding: 6px 12px;
            border-radius: 6px;
            font-weight: 700;
            font-size: 0.8em;
            margin-right: 16px;
            min-width: 65px;
            text-align: center;
            border: 1px solid;
        }

        .method.get {
            background: oklch(0.5 0.15 150 / 0.2);
            color: oklch(0.7 0.15 150);
            border-color: oklch(0.5 0.15 150 / 0.4);
        }

        .method.post {
            background: oklch(0.6 0.1 180 / 0.2);
            color: oklch(0.7 0.1 180);
            border-color: oklch(0.6 0.1 180 / 0.4);
        }

        .method.put {
            background: oklch(0.65 0.15 65 / 0.2);
            color: oklch(0.8 0.15 65);
            border-color: oklch(0.65 0.15 65 / 0.4);
        }

        .method.delete {
            background: oklch(0.5 0.2 25 / 0.2);
            color: oklch(0.7 0.2 25);
            border-color: oklch(0.5 0.2 25 / 0.4);
        }

        .path {
            font-family: 'Courier New', monospace;
            flex: 1;
            color: oklch(0.8 0 0);
            font-size: 0.95em;
        }

        .description {
            color: oklch(0.65 0 0);
            font-size: 0.9em;
            margin-left: 16px;
        }

        footer {
            background: oklch(0 0 0 / 0.3);
            border-top: 1px solid oklch(1 0 0 / 0.1);
            padding: 24px;
            text-align: center;
            color: oklch(0.65 0 0);
            border-radius: 0.75rem;
            margin-top: 24px;
        }

        code {
            background: oklch(0.08 0 0 / 0.8);
            color: oklch(0.8 0.1 180);
            padding: 4px 10px;
            border-radius: 6px;
            font-family: 'Courier New', monospace;
            font-size: 0.9em;
            border: 1px solid oklch(1 0 0 / 0.1);
        }

        pre {
            background: oklch(0.03 0 0);
            color: oklch(0.85 0 0);
            padding: 24px;
            border-radius: 0.75rem;
            overflow-x: auto;
            margin: 20px 0;
            border: 1px solid oklch(1 0 0 / 0.1);
        }

        pre code {
            background: none;
            padding: 0;
            border: none;
            color: oklch(0.85 0 0);
        }

        a {
            color: oklch(0.7 0.12 180);
            text-decoration: none;
            font-weight: 600;
            transition: color 0.2s ease;
        }

        a:hover {
            color: oklch(0.8 0.14 180);
            text-decoration: underline;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin: 20px 0;
        }

        table th {
            background: oklch(0.08 0 0 / 0.8);
            color: oklch(0.95 0 0);
            padding: 14px;
            text-align: left;
            font-weight: 600;
            border-bottom: 2px solid oklch(0.6 0.1 180);
        }

        table td {
            padding: 14px;
            border-bottom: 1px solid oklch(1 0 0 / 0.1);
            color: oklch(0.85 0 0);
        }

        table tr:hover {
            background: oklch(0.08 0 0 / 0.3);
        }
    </style>
</head>
<body>
    <%- body %>
</body>
</html>

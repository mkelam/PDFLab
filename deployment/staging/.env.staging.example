# Staging Environment Variables
# Copy this file to .env.staging and update with real values

# Database
MYSQL_ROOT_PASSWORD=staging_root_password_here
MYSQL_PASSWORD=staging_db_password_here

# JWT Authentication
JWT_SECRET=staging_jwt_secret_minimum_32_characters_long

# CloudConvert (use production API, not sandbox)
CLOUDCONVERT_API_KEY=your_cloudconvert_api_key_here

# PayFast (use sandbox mode for staging)
PAYFAST_MERCHANT_ID=10000100  # PayFast sandbox merchant ID
PAYFAST_MERCHANT_KEY=46f0cd694581a  # PayFast sandbox merchant key
PAYFAST_PASSPHRASE=your_staging_passphrase
PAYFAST_MODE=sandbox

# Email (optional - can use same as production or test service)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=support@pdflab.pro
SMTP_PASS=your_smtp_password
SMTP_FROM=support@pdflab.pro
